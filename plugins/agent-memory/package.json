{
  "name": "agent-memory",
  "version": "0.2.2",
  "description": "多 agent 分片项目记忆：每个 agent 独占写自己的目录，工具聚合生成只读索引。不绑定任何 agent 或语言。",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-memory": "./bin/agent-memory.mjs"
  },
  "exports": {
    ".": "./skills/project-memory/scripts/core.mjs",
    "./mcp": "./skills/project-memory/scripts/mcp.mjs"
  },
  "files": [
    "bin",
    "skills",
    "templates",
    ".codex-plugin",
    ".claude-plugin",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YQXYK/agent-memory.git",
    "directory": "plugins/agent-memory"
  },
  "homepage": "https://github.com/YQXYK/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/YQXYK/agent-memory/issues"
  },
  "author": {
    "name": "YQXYK",
    "url": "https://github.com/YQXYK"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node ../../scripts/test.mjs",
    "mcp": "node skills/project-memory/scripts/mcp.mjs"
  },
  "keywords": [
    "memory",
    "multi-agent",
    "context",
    "handoff",
    "mcp"
  ]
}
